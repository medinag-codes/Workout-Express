  <div>
    <h3>My Workouts:</h3>
    <ul class="wokouts">
    <% for(var i=0; i<workouts.length; i++) {%>
      <li class="workout">
        <a href="workouts[i].name"><span><%= workouts[i].name %></span></a>
        <span><%= workouts[i].type %></span>
        <span><%= workouts[i].muscle %></span>
        <span><%= workouts[i].equipment %></span>
        <span><%= workouts[i].difficulty %></span>
        <span><%= workouts[i].thumbUp %></span>
        <span><i class="fa fa-thumbs-up" aria-hidden="true"></i></span>
        <span><i class="fa fa-thumbs-down" aria-hidden="true"></i></span>
        <span><i class="fa fa-trash" aria-hidden="true"></i></span>
      </li>
    <% } %>
    </ul>
  </div>

  <h2>Add a new workout</h2>
  <form action="/workouts" method="POST">
    <input type="text" placeholder="name" name="name" value="">
    <input type="text" placeholder="type" name="type" value="">
    <input type="text" placeholder="muscle" name="muscle" value="">
    <input type="text" placeholder="equipment" name="equipment" value="">
    <input type="text" placeholder="difficulty" name="difficulty" value="">
    <input type="text" placeholder="instruction" name="instructions" value="">
    <button type="submit">Submit</button>
  </form>

  <script src="main.js"></script>

